# Local toolchain (37MB arduino-cli binary)
bin/

# Third-party reference app — separate project (KacperKozak/vesc-app-poc), not ours to publish
vesc-app-poc-dev/

# Third-party Refloat firmware source — local reference only (GPL, upstream repo), not ours to publish
refloat-main/

# Local Claude Code settings (machine-specific)
.claude/

# macOS / editor cruft
.DS_Store
**/.DS_Store

# Build artifacts
*.bin
*.elf
*.hex
*.map
build/

# Scratch
analysis/

# Ride logs. This repo is PUBLIC and these carry GPS lat/lon for every session —
# publishing them publishes where the rider lives and rides. Curated extracts for
# a specific analysis go in data/boards/<board>/ instead, with GPS stripped.
sessions/

# SD card dump. Contains BruceRFID/keys.conf — RFID keys must never be published.
SD /
"SD "/

# but DO ship decoded-config blobs for the web app
!web/rides/*.bin

# Session handoff notes. Written as a private working document — it carries rider
# details (weight, riding habits) that belong in analysis, not in a public repo.
# Lives in ~/vesc-tuner-private/ instead.
HANDOFF.md

# Third-party VESCape app source — local reference only (GPL-3.0, upstream repo),
# not ours to publish. We took ideas and the .jsonl line format, never code.
vescape-dev/
